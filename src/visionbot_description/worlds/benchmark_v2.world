<?xml version="1.0" encoding="utf-8"?>
<sdf version='1.8'>
  <world name='benchmark_v2'>

    <!--
    ================================================================
    VisionBot Benchmark World v2  —  Trosoba stan
    ================================================================

    Osnova: 16m (X) x 12m (Y), visina 2.8m
    Robot start: (7.5, 5.5) — hodnik, okrenuto prema dnevnoj sobi

    Koordinatni sistem:
      X+ = istok (desno),  X- = zapad (levo)
      Y+ = sever (gore),   Y- = jug (dole)
      (0, 0) = jugozapadni ugao

    Raspored soba:
    ┌─────────────┬──────────────────────────┐  Y=12
    │             │                          │
    │  SPAVAĆA    │      DNEVNA SOBA         │
    │  SOBA       │      (X: 6–16, Y: 5–12)  │
    │  (X:0–6,    │                          │
    │   Y: 5–12)  │                          │
    │             │                          │
    ├──────┬──────┤                          │  Y=5
    │      │otvor │                          │
    │      └──────┴──────────────────────────┤  Y=5
    │               KUHINJA                  │
    │          (X: 0–16, Y: 0–5)             │
    │                                        │
    └────────────────────────────────────────┘  Y=0
    X=0                                     X=16

    Otvori (bez vrata):
      Kuhinja → hodnik:   X=[6.5, 9.5] na Y=5.0  (3m siroko)
      Hodnik → spavaća:   Y=[6.5, 8.5] na X=6.0  (2m siroko)

    Podovi:
      Kuhinja:     keramicke plocice (svetlo sive, visoki specular)
      Dnevna:      parket (toplo smedje)
      Spavaća:     tepih (bež/krem)
      Hodnik:      parket (isto kao dnevna)

    Zidovi:
      Spoljni:     krem boja (malo toplije od bijele)
      Unutrašnji:  bijelo-siva boja
    ================================================================
    -->

    <physics name="10ms" type="ignored">
      <max_step_size>0.010</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.6 0.6 1</background>
    </scene>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <!-- ===========================================================
         RASVETA
         Sunce (difuzno, bez sjenki) + po jedna tacka lampa po sobi
    =========================================================== -->

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Kuhinja: hladnija bijela svjetlost (fluo) -->
    <light name='light_kitchen' type='point'>
      <pose>8.0 2.5 2.5 0 0 0</pose>
      <diffuse>1.0 1.0 0.96 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>15</range>
        <constant>0.25</constant>
        <linear>0.03</linear>
        <quadratic>0.006</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Dnevna soba: topla bijela (halogen) -->
    <light name='light_living' type='point'>
      <pose>11.0 9.0 2.5 0 0 0</pose>
      <diffuse>1.0 0.97 0.88 1</diffuse>
      <specular>0.12 0.12 0.10 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.28</constant>
        <linear>0.04</linear>
        <quadratic>0.007</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Spavaća soba: topla, malo prigušena -->
    <light name='light_bedroom' type='point'>
      <pose>3.0 9.0 2.5 0 0 0</pose>
      <diffuse>0.95 0.90 0.80 1</diffuse>
      <specular>0.08 0.08 0.07 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.30</constant>
        <linear>0.05</linear>
        <quadratic>0.010</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===========================================================
         PODOVI  (odvojeni modeli po sobama radi razlicitih materijala)
    =========================================================== -->

    <!-- Kuhinja: keramicke plocice (X:[0,16], Y:[0,5])
         Svjetlo sive, visoki specular = sjajno -->
    <model name='floor_kitchen'>
      <static>true</static>
      <pose>8.0 2.5 -0.02 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>16.0 5.0 0.04</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>16.0 5.0 0.04</size></box></geometry>
          <material>
            <ambient>0.78 0.78 0.76 1</ambient>
            <diffuse>0.86 0.86 0.84 1</diffuse>
            <specular>0.40 0.40 0.40 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dnevna soba + hodnik: parket (X:[6,16], Y:[5,12])
         Toplo smedje, malo sjajno -->
    <model name='floor_living'>
      <static>true</static>
      <pose>11.0 8.5 -0.02 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>10.0 7.0 0.04</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>10.0 7.0 0.04</size></box></geometry>
          <material>
            <ambient>0.35 0.22 0.10 1</ambient>
            <diffuse>0.50 0.32 0.14 1</diffuse>
            <specular>0.10 0.07 0.03 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Spavaća soba: tepih (X:[0,6], Y:[5,12])
         Béž/krem, bez sjaja -->
    <model name='floor_bedroom'>
      <static>true</static>
      <pose>3.0 8.5 -0.02 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>6.0 7.0 0.04</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>6.0 7.0 0.04</size></box></geometry>
          <material>
            <ambient>0.62 0.55 0.43 1</ambient>
            <diffuse>0.72 0.64 0.50 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===========================================================
         PLAFON (jedan komad, pomaže rasprsivanju svjetlosti)
    =========================================================== -->

    <model name='ceiling'>
      <static>true</static>
      <pose>8.0 6.0 2.82 0 0 0</pose>
      <link name='link'>
        <visual name='vis'>
          <geometry><box><size>16.1 12.1 0.04</size></box></geometry>
          <material>
            <ambient>0.96 0.96 0.95 1</ambient>
            <diffuse>0.96 0.96 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===========================================================
         SPOLJNI ZIDOVI
         Debljina: 0.15m, Visina: 2.8m
         Krem boja — malo toplija od bijele
    =========================================================== -->

    <!-- Juzni zid  Y=0 -->
    <model name='wall_south'>
      <static>true</static>
      <pose>8.0 -0.075 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>16.3 0.15 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>16.3 0.15 2.8</size></box></geometry>
          <material>
            <ambient>0.91 0.89 0.84 1</ambient>
            <diffuse>0.93 0.91 0.86 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sjeverni zid  Y=12 -->
    <model name='wall_north'>
      <static>true</static>
      <pose>8.0 12.075 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>16.3 0.15 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>16.3 0.15 2.8</size></box></geometry>
          <material>
            <ambient>0.91 0.89 0.84 1</ambient>
            <diffuse>0.93 0.91 0.86 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zapadni zid  X=0 -->
    <model name='wall_west'>
      <static>true</static>
      <pose>-0.075 6.0 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.15 12.3 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 12.3 2.8</size></box></geometry>
          <material>
            <ambient>0.91 0.89 0.84 1</ambient>
            <diffuse>0.93 0.91 0.86 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Istocni zid  X=16 -->
    <model name='wall_east'>
      <static>true</static>
      <pose>16.075 6.0 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.15 12.3 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 12.3 2.8</size></box></geometry>
          <material>
            <ambient>0.91 0.89 0.84 1</ambient>
            <diffuse>0.93 0.91 0.86 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===========================================================
         UNUTRASNJI ZIDOVI
         Bijelo-siva boja — malo svjetlija od spoljnih
    =========================================================== -->

    <!--
    Horizontalni zid: razdvaja kuhinju (Y<5) od spavace+dnevne (Y>5)
    Otvor za hodnik: X=[6.5, 9.5]  →  3.0m sirine
    Lijevi segment:  X=[0.0,  6.5], duzina=6.5m, centar X=3.25
    Desni segment:   X=[9.5, 16.0], duzina=6.5m, centar X=12.75
    -->
    <model name='iwall_h_left'>
      <static>true</static>
      <pose>3.25 5.0 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>6.5 0.15 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>6.5 0.15 2.8</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.86 1</ambient>
            <diffuse>0.90 0.90 0.88 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name='iwall_h_right'>
      <static>true</static>
      <pose>12.75 5.0 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>6.5 0.15 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>6.5 0.15 2.8</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.86 1</ambient>
            <diffuse>0.90 0.90 0.88 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!--
    Vertikalni zid: razdvaja spavacu (X<6) od dnevne (X>6)
    Otvor za prolaz: Y=[6.5, 8.5]  →  2.0m sirine
    Donji segment:  Y=[5.0, 6.5], duzina=1.5m, centar Y=5.75
    Gornji segment: Y=[8.5,12.0], duzina=3.5m, centar Y=10.25
    -->
    <model name='iwall_v_bottom'>
      <static>true</static>
      <pose>6.0 5.75 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.15 1.5 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 1.5 2.8</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.86 1</ambient>
            <diffuse>0.90 0.90 0.88 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name='iwall_v_top'>
      <static>true</static>
      <pose>6.0 10.25 1.4 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.15 3.5 2.8</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 3.5 2.8</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.86 1</ambient>
            <diffuse>0.90 0.90 0.88 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===========================================================
         ROBOT SPAWN ZONA  —  hodnik, okrenuto prema dnevnoj sobi
         Pozicija: (7.5, 5.5)
         - X=7.5: u sredini otvora X=[6.5, 9.5] (centar=8.0, malo lijevije)
         - Y=5.5: odmah iza zida kuhinje, ni blizu zida ni u kuhinji
         - Robot dimenzije: ~0.3x0.3m — slobodan prostor svuda >1m
         - Yaw=1.5708 (90°): okrenuto prema dnevnoj sobi (Y+)
         Vidljivost iz ove pozicije:
           - Dnevna soba otvara se direktno naprijed
           - Spavaća soba vidljiva kroz otvor na lijevoj strani
           - Kuhinja vidljiva kroz otvor pozadi
    =========================================================== -->

    <!--
         NAPOMENA ZA SPAWN:
         U launch fajlu postavi robot na:
           x=7.5, y=5.5, z=0.0, yaw=1.5708
         Primjer u gazebo.launch.py:
           x_pose='7.5', y_pose='5.5', z_pose='0.0', yaw='1.5708'
    -->

  </world>
</sdf>
