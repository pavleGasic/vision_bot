<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertia_macros.xacro" />

  <xacro:property name="camera_neck_length" value="0.001" />
  <xacro:property name="camera_neck_width" value="0.01" />
  <xacro:property name="camera_neck_height" value="0.01" />

  <xacro:property name="camera_height" value="0.01" />

  <xacro:property name="chassis_length" value="0.17" />
  <xacro:property name="chassis_height" value="0.035" />

  <xacro:property name="camera_neck_offset_x" value="${(chassis_length/3) + 0.01}" />
  <xacro:property name="camera_neck_offset_z"
    value="${chassis_height + (camera_neck_height / 2) - 0.015}" />

  <xacro:property name="camera_offset_z" value="${(camera_neck_height/2) + (camera_height / 2)}" />

  <joint name="camera_neck_joint" type="fixed">
    <parent link="chassis" />
    <child link="camera_neck_link" />
    <origin xyz="${camera_neck_offset_x} 0 ${camera_neck_offset_z}" rpy="0 0 0" />
  </joint>

  <link name="camera_neck_link">
    <visual>
      <geometry>
        <box size="${camera_neck_length} ${camera_neck_width} ${camera_neck_height}" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="${camera_neck_length} ${camera_neck_width} ${camera_neck_height}" />
      </geometry>
      <material name="white" />
    </collision>
    <xacro:inertial_box mass="0.1" x="${camera_neck_length}" y="${camera_neck_width}"
      z="${camera_neck_height}">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_neck_link" />
    <child link="camera_link" />
    <origin xyz="0.0075 0 ${camera_offset_z}" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <mesh filename="package://visionbot_description/description/meshes/rpi_camera_link.stl" />
      </geometry>
      <material name="green" />
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001" />
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_link_optical" />
    <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}" />
  </joint>

  <link name="camera_link_optical"></link>
</robot>
